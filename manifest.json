{
  "manifest_version": 3,
  "name": "Cookie Transfer",
  "description": "Export and import all cookies, plus each site's local storage and IndexedDB, in one shot.",
  "version": "2.3.0",
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "tabs",
    "history",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Transfer"
  }
}
